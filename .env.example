# Leave these empty to run in demo mode with built-in mock events.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (set in Vercel, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
QUICKET_API_KEY=
# Free key from aistudio.google.com, used to read event posters
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
